# /etc/systemd/system/ndvi-capture.path
#
# Watches for the mission-start trigger file written by msp_uart_service.py
# when the first waypoint (wp > 0) is reached. Activates ndvi-capture.service
# exactly once per boot.
#
# Deploy:
#   sudo cp ndvi-capture.path    /etc/systemd/system/
#   sudo cp ndvi-capture.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl disable ndvi-capture.service   # remove old boot activation
#   sudo systemctl enable  ndvi-capture.path
#   sudo systemctl start   ndvi-capture.path

[Unit]
Description=Activate NDVI capture when mission waypoint reached
After=agrodrone-msp-uart.service

[Path]
PathExists=/tmp/capture_start.txt
Unit=ndvi-capture.service

[Install]
WantedBy=multi-user.target
