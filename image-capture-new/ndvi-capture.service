# /etc/systemd/system/ndvi-capture.service
#
# Boot-start capture unit. Starts at boot, warms cameras immediately, then
# captures every 10 seconds. Position metadata is polled non-blocking from
# the MSP UART service; captures continue with null position if unavailable.
# Restarts automatically so the system is ready for the next flight without
# a reboot.
#
# Deploy:
#   sudo cp ndvi-capture.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable ndvi-capture.service
#   sudo systemctl start ndvi-capture.service
#
# Useful commands:
#   sudo systemctl status ndvi-capture.service
#   journalctl -u ndvi-capture.service -f

[Unit]
Description=NDVI Dual Camera Capture
After=multi-user.target agrodrone-msp-uart.service
Wants=agrodrone-msp-uart.service

[Service]
Type=simple
User=sr-design
WorkingDirectory=/home/sr-design/agrodrone-system

EnvironmentFile=/home/sr-design/EC463_Team_17_AgroDrone/.env

ExecStart=/usr/bin/python3 /home/sr-design/agrodrone-system/ndvi_image_capture.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
